# SPA routing for TanStack Start static build (Apache on Gandi PHP hosting).
# Serve existing files/directories as-is; otherwise fall back to index.html.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dynamic sitemap: served by a Supabase Edge Function so newly added
  # partitions appear without a rebuild. Kept on-domain via redirect.
  RewriteRule ^sitemap\.xml$ https://ibztpfdeodpxzzuzaidn.supabase.co/functions/v1/sitemap [R=302,L]

  # Do not rewrite real files or directories (assets, robots.txt…)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Cache static assets; keep HTML fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
